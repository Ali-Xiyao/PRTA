{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prta-cxr.protected-label-quality-review-batch.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "ai_label", "quality_flags"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "ai_label": {
            "enum": ["Improved", "Worse", "New", "Resolved", "Stable", "Unclear"]
          },
          "quality_flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "REPORT_INSUFFICIENT",
                "PAIRING_ABNORMAL",
                "FINDING_NOT_JUDGEABLE",
                "TEMPORAL_DIRECTION_AMBIGUOUS",
                "NEGATION_OR_UNCERTAINTY_CONFLICT"
              ]
            }
          }
        }
      }
    }
  }
}
