{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prta-cxr.independent-silver-label-batch.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "ai_label"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "ai_label": {
            "enum": [
              "Improved",
              "Worse",
              "New",
              "Resolved",
              "Stable",
              "Unclear"
            ]
          }
        }
      }
    }
  }
}
