{
  "schema": "prta-cxr.vlm-additional-protocol.v1",
  "source_method": "B404-S17",
  "source_selection": "frozen_before_formal_outcomes",
  "model": {
    "path_source": "protocol_freeze.vlm_model_config.parent",
    "model_type": "qwen3_vl",
    "hidden_size": 2560,
    "dtype": "bfloat16",
    "attention_implementation": "eager",
    "local_files_only": true,
    "all_frozen": true
  },
  "interface": {
    "token_budget": 64,
    "input_width": 768,
    "layout": [4, 12, 16, 16, 12, 4],
    "active_tokens": 60,
    "reserved_tokens": 4,
    "sentinel_token": "<|fim_pad|>",
    "placeholder_token_id": 151662,
    "pixel_inputs_used": false,
    "label_order": ["Stable", "Improved", "Worse", "New", "Resolved"]
  },
  "training": {
    "split": "train",
    "rows": 2500,
    "sampling": "sha256_patient_then_sample_v1",
    "seed": 17,
    "epochs": 1,
    "micro_batch_size": 1,
    "gradient_accumulation": 32,
    "effective_batch_size": 32,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "class_patient_balanced_loss": true,
    "early_stopping": false,
    "architecture_search": false
  },
  "evaluation": {
    "cohort": "expert_gold",
    "rows": 250,
    "structured_output_only": true,
    "free_text_qualitative_only": true,
    "outcome_selection": false
  },
  "inclusion_gate": {
    "minimum_macro_f1": 0.30,
    "minimum_schema_validity": 0.99,
    "minimum_finding_consistency": 0.99,
    "maximum_temporal_contradiction": 0.10,
    "failure_action": "omit_additional_section_without_changing_prta"
  },
  "scope": {
    "baseline_matrix": false,
    "backpropagate_decision_to_vit": false,
    "clinical_report_generation_claim": false
  }
}
